        "backgroundNetwork": false,
        "createTelemetryId": false
      }
    },
    {
      "name": "offline-yes",
      "env": { "HARNESS_OFFLINE": "yes" },
      "consent": true,
      "crashConsent": true,
      "expect": {
        "doNotTrack": false,
        "offline": true,
        "productTelemetry": false,
        "crashUpload": false,
        "backgroundNetwork": false,
        "createTelemetryId": false
      }
    },
    {
      "name": "offline-zero-is-not-set",
