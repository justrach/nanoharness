    {
      "name": "dnt-zero-is-not-set",
      "env": { "DO_NOT_TRACK": "0" },
      "consent": true,
      "crashConsent": true,
      "expect": {
        "doNotTrack": false,
        "offline": false,
        "productTelemetry": true,
        "crashUpload": true,
        "backgroundNetwork": true,
        "createTelemetryId": true
      }
    },
    {
      "name": "dnt-false-is-not-set",
      "env": { "DO_NOT_TRACK": "false" },
