      "crashConsent": true,
      "expect": {
        "doNotTrack": true,
        "offline": false,
        "productTelemetry": false,
        "crashUpload": false,
        "backgroundNetwork": false,
        "createTelemetryId": false
      }
    },
    {
      "name": "dnt-true-uppercase",
      "env": { "DO_NOT_TRACK": "TRUE" },
      "consent": true,
      "crashConsent": true,
